//|                                        RickEA_SuperTrend_Bot.mq5 |
//|                                Copyright 2025, Richartrader Ltd. |
//|                                             https://www.mql5.com |
//+------------------------------------------------------------------+
//| Robo baseado no indicador RickEA SuperTrend V-2.                 |
//| - Desenha no grafico a SuperTrend (verde/vermelha), a EMA e as   |
//|   setas do indicador original (douradas e de engolfo).           |
//| - Entra automaticamente quando a SuperTrend vira de cor, somente |
//|   em vela de forca + volume (evita mercado lateral).             |
//| - Stop no ultimo fundo/topo, take em risco:retorno, BE, trailing,|
//|   metas/stops por ciclo e diarios, horario pelo relogio do PC.   |
//| - Preco grande no canto superior direito, painel a esquerda e    |
//|   logo RickEA embutido (nao precisa de arquivo em Images).       |
//+------------------------------------------------------------------+
#property copyright "Copyright 2025, Richartrader Ltd."
#property link      "https://www.mql5.com"
#property version   "1.00"
#property description "RickEA SuperTrend Bot - entradas automaticas na virada de cor da SuperTrend"

#include <Trade\Trade.mqh>

//+------------------------------------------------------------------+
//| Enums                                                            |
//+------------------------------------------------------------------+
enum ENUM_DIRECAO
  {
   DIR_AMBOS      = 0,  // Compras e Vendas
   DIR_SO_COMPRA  = 1,  // So Compras
   DIR_SO_VENDA   = 2   // So Vendas
  };

enum ENUM_STOP_MODO
  {
   STOP_ULTIMO_FUNDO = 0, // Ultimo fundo (compra) / ultimo topo (venda)
   STOP_PONTOS       = 1, // Pontos fixos
   STOP_NENHUM       = 2  // Sem stop
  };

enum ENUM_TAKE_MODO
  {
   TAKE_NENHUM = 0, // Sem take
   TAKE_RR_1_1 = 1, // Risco:Retorno 1:1
   TAKE_RR_1_2 = 2, // Risco:Retorno 1:2
   TAKE_RR_1_3 = 3, // Risco:Retorno 1:3
   TAKE_PONTOS = 4  // Pontos fixos
  };

enum ENUM_LOTE_MODO
  {
   LOTE_FIXO       = 0, // Lote fixo
   LOTE_PERCENTUAL = 1  // Percentual de risco do saldo
  };

enum ENUM_ADX_LINHA
  {
   ADX_LINHA_MAIN  = 0, // ADX (linha principal)
   ADX_LINHA_PLUS  = 1, // +DI
   ADX_LINHA_MINUS = 2  // -DI (igual ao indicador original)
  };

enum ENUM_LOGO_POS
  {
   LOGO_CENTRO  = 0, // Centro do grafico
   LOGO_INF_DIR = 1, // Inferior direito
   LOGO_INF_ESQ = 2  // Inferior esquerdo
  };

//+------------------------------------------------------------------+
//| Inputs                                                           |
//+------------------------------------------------------------------+
input group "=== Operacional ==="
input ENUM_DIRECAO   InpDirecao          = DIR_AMBOS;  // Direcao das entradas
input bool           InpUmaEntradaCiclo  = true;       // Uma entrada por ciclo (true/false)
input int            InpJanelaVirada     = 3;          // Velas apos a virada para aceitar a 1a entrada (0 = so na vela da virada)
input bool           InpFecharNaVirada   = true;       // Fechar posicao quando a SuperTrend virar contra
input ulong          InpMagic            = 250925;     // Numero magico
input int            InpSlippage         = 30;         // Desvio maximo (pontos)
input string         InpComentario       = "RickEA ST Bot"; // Comentario das ordens

input group "=== Filtro: vela de forca + volume (anti lateral) ==="
input bool           InpUsarVelaForca    = true;       // Exigir vela de forca
input double         InpCorpoMinPct      = 60.0;       // Corpo minimo da vela (% do tamanho total)
input double         InpForcaATRMult     = 1.0;        // Tamanho minimo da vela (x ATR). 0 = desliga
input bool           InpUsarVolume       = true;       // Exigir volume acima da media
input int            InpVolumePeriodo    = 20;         // Periodo da media de volume
input double         InpVolumeMult       = 1.2;        // Volume >= media x este fator
input bool           InpVolumeReal       = false;      // Usar volume real (false = volume de ticks)
input bool           InpFiltroEMA        = false;      // Filtro extra: preco acima/abaixo da EMA
input bool           InpFiltroADX        = false;      // Filtro extra: ADX na faixa min/max

input group "=== Lote ==="
input ENUM_LOTE_MODO InpLoteModo         = LOTE_FIXO;  // Tipo de lote
input double         InpLoteFixo         = 0.10;       // Lote fixo
input double         InpRiscoPct         = 1.0;        // Risco por operacao (% do saldo) - usa a distancia do stop

input group "=== Stop Loss ==="
input ENUM_STOP_MODO InpStopModo         = STOP_ULTIMO_FUNDO; // Tipo de stop
input int            InpFundoPivo        = 2;          // Velas de cada lado para confirmar fundo/topo
input int            InpFundoLookback    = 50;         // Procurar fundo/topo nas ultimas N velas
input int            InpStopFolgaPts     = 20;         // Folga alem do fundo/topo (pontos)
input int            InpStopPontos       = 300;        // Stop em pontos (modo pontos fixos)
input int            InpStopMaxPts       = 0;          // Stop maximo aceito (pontos). Maior = nao entra. 0 = sem limite

input group "=== Take Profit ==="
input ENUM_TAKE_MODO InpTakeModo         = TAKE_RR_1_2; // Tipo de take
input int            InpTakePontos       = 600;        // Take em pontos (modo pontos fixos)

input group "=== Break Even ==="
input bool           InpUsarBE           = false;      // Ativar Break Even
input int            InpBEGatilhoPts     = 200;        // Lucro (pontos) para mover o stop
input int            InpBEOffsetPts      = 10;         // Stop vai para entrada + estes pontos

input group "=== Trailing Stop (so no positivo) ==="
input bool           InpUsarTrailing     = false;      // Ativar Trailing Stop
input int            InpTrailInicioPts   = 300;        // Comeca a seguir quando lucro >= pontos
input int            InpTrailDistPts     = 200;        // Distancia do stop ao preco (pontos)
input int            InpTrailPassoPts    = 20;         // Passo minimo para mover (pontos)

input group "=== Metas e Stops em dinheiro (moeda da conta) ==="
input bool           InpUsarMetaCiclo    = false;      // Take por ciclo
input double         InpMetaCiclo        = 50.0;       // Lucro do ciclo para encerrar o ciclo
input bool           InpUsarMetaDia      = false;      // Take global (diario)
input double         InpMetaDia          = 150.0;      // Lucro do dia para parar
input bool           InpUsarStopDia      = false;      // Stop global (diario)
input double         InpStopDia          = 100.0;      // Perda do dia para parar

input group "=== Horario (relogio do PC, nao do servidor) ==="
input bool           InpUsarHorario      = true;       // Operar so dentro do horario
input string         InpHoraInicio       = "09:00";    // Inicio (HH:MM - hora do PC)
input string         InpHoraFim          = "17:30";    // Fim (HH:MM - hora do PC)
input bool           InpFecharFimHorario = false;      // Fechar posicoes ao sair do horario

input group "=== Visual ==="
input bool           InpShowSupertrend   = true;       // Mostrar SuperTrend
input bool           InpShowEMA          = true;       // Mostrar EMA
input bool           InpShowSignals      = true;       // Mostrar setas douradas do indicador
input bool           InpShowEngolfo      = true;       // Mostrar setas de engolfo
input bool           InpShowEntradas     = true;       // Marcar as entradas do robo no grafico
input int            InpBarsDraw         = 400;        // Velas desenhadas
input color          InpCorAlta          = clrLime;    // Cor SuperTrend alta
input color          InpCorBaixa         = clrTomato;  // Cor SuperTrend baixa
input color          InpCorEMA           = clrDeepSkyBlue; // Cor EMA
input bool           InpShowPreco        = true;       // Preco grande no canto superior direito
input int            InpPrecoFonte       = 30;         // Tamanho da fonte do preco
input bool           InpShowPainel       = true;       // Painel a esquerda
input bool           InpShowLogo         = true;       // Logo RickEA no fundo do grafico
input ENUM_LOGO_POS  InpLogoPos          = LOGO_CENTRO; // Posicao do logo
input int            InpLogoTamanho      = 260;        // Tamanho do logo (px)
input int            InpLogoOpacidade    = 45;         // Opacidade do logo (0-255)

input group "=== Indicador base (SuperTrend / EMA / ADX) ==="
input int            InpADX_RisingBars   = 2;          // ADX deve subir por X candles consecutivos
input bool           InpOnlyOneSignalPerFlip = true;   // Setas so quando muda a direcao do Supertrend
input ENUM_ADX_LINHA InpADXLinha         = ADX_LINHA_MINUS; // Linha do ADX usada (original usa -DI)

input int            InpATR_Period       = 10;         // Periodo do ATR
input double         InpST_Mult          = 3.0;        // Multiplicador da SuperTrend
input int            InpEMA_Period       = 50;         // Periodo da EMA
input int            InpADX_Period       = 14;         // Periodo do ADX
input double         InpADX_Min          = 15.0;       // ADX minimo
input double         InpADX_Max          = 45.0;       // ADX maximo

//+------------------------------------------------------------------+
//| Globais                                                          |
//+------------------------------------------------------------------+
#define PFX       "RSTB_"
#define CALC_BARS 1500
#define LOGO_RES  "::RickEA_STBot_Logo"

CTrade   trade;

int      hEMA = INVALID_HANDLE, hADX = INVALID_HANDLE, hATR = INVALID_HANDLE;
int      gLastEMA = -1, gLastADX = -1, gLastATR = -1;

// parametros gerais (mesmos para todos os dias)
int      pATR = 10, pEMA = 50, pADX = 14;
double   pMult = 3.0, pADXMin = 15.0, pADXMax = 45.0;

// series (indice 0 = vela atual)
MqlRates gRates[];
double   gATR[], gEMA[], gADX[];
double   gUpper[], gLower[], gTrend[], gST[];
int      gN = 0;

datetime gLastBarTime = 0;
double   gLastBid     = 0.0;
color    gCorPreco    = clrWhite;
int      gIniMin = 0, gFimMin = 0;

// estado (atualizado 1x por segundo / nova vela)
datetime gCicloInicio   = 0;
int      gCicloBarras   = 0;   // velas fechadas desde a virada (0 = virou na vela 1)
int      gCicloEntradas = 0;
double   gCicloResultado = 0.0;
int      gDiaEntradas   = 0;
double   gDiaResultado  = 0.0;
string   gStatus        = "";

void LogoCriar();   // definida no fim do arquivo (junto dos pixels do logo)
void LogoPosicionar();

//+------------------------------------------------------------------+
//| Utilidades                                                       |
//+------------------------------------------------------------------+
int ParseHHMM(string s)
  {
   StringTrimLeft(s);
   StringTrimRight(s);
   string p[];
   if(StringSplit(s, ':', p) < 2)
      return (int)StringToInteger(s) * 60;
   return (int)StringToInteger(p[0]) * 60 + (int)StringToInteger(p[1]);
  }

int MinutoLocal()
  {
   MqlDateTime dt;
   TimeToStruct(TimeLocal(), dt);
   return dt.hour * 60 + dt.min;
  }

bool DentroHorario()
  {
   if(!InpUsarHorario)
      return true;
   int m = MinutoLocal();
   if(gIniMin == gFimMin)
      return true;
   if(gIniMin < gFimMin)
      return (m >= gIniMin && m < gFimMin);
   return (m >= gIniMin || m < gFimMin);   // janela que cruza a meia-noite
  }

// inicio do dia do PC convertido para hora do servidor (para ler o historico)
datetime InicioDiaServidor()
  {
   MqlDateTime dt;
   TimeToStruct(TimeLocal(), dt);
   int seg = dt.hour * 3600 + dt.min * 60 + dt.sec;
   return TimeTradeServer() - seg;
  }

string Moeda()
  {
   return AccountInfoString(ACCOUNT_CURRENCY);
  }

string Sinal(double v)
  {
   return (v >= 0 ? "+" : "") + DoubleToString(v, 2);
  }

bool EnsureHandles()
  {
   if(hEMA == INVALID_HANDLE || pEMA != gLastEMA)
     {
      if(hEMA != INVALID_HANDLE) IndicatorRelease(hEMA);
      hEMA = iMA(_Symbol, _Period, pEMA, 0, MODE_EMA, PRICE_CLOSE);
      gLastEMA = pEMA;
     }
   if(hADX == INVALID_HANDLE || pADX != gLastADX)
     {
      if(hADX != INVALID_HANDLE) IndicatorRelease(hADX);
      hADX = iADX(_Symbol, _Period, pADX);
      gLastADX = pADX;
     }
   if(hATR == INVALID_HANDLE || pATR != gLastATR)
     {
      if(hATR != INVALID_HANDLE) IndicatorRelease(hATR);
      hATR = iATR(_Symbol, _Period, pATR);
      gLastATR = pATR;
     }
   return (hEMA != INVALID_HANDLE && hADX != INVALID_HANDLE && hATR != INVALID_HANDLE);
  }

//+------------------------------------------------------------------+
//| Calculo da SuperTrend (mesma logica do indicador V-2)            |
//+------------------------------------------------------------------+
bool Calcular()
  {
   pATR = MathMax(1, InpATR_Period);  pMult   = InpST_Mult;
   pEMA = MathMax(1, InpEMA_Period);  pADX    = MathMax(1, InpADX_Period);
   pADXMin = InpADX_Min;              pADXMax = InpADX_Max;
   if(!EnsureHandles())
      return false;

   int n = MathMin(Bars(_Symbol, _Period), CALC_BARS);
   if(n < 100)
      return false;

   ArraySetAsSeries(gRates, true);
   ArraySetAsSeries(gATR, true);
   ArraySetAsSeries(gEMA, true);
   ArraySetAsSeries(gADX, true);

   if(CopyRates(_Symbol, _Period, 0, n, gRates) < n) return false;
   if(CopyBuffer(hATR, 0, 0, n, gATR) < n)          return false;
   if(CopyBuffer(hEMA, 0, 0, n, gEMA) < n)          return false;
   if(CopyBuffer(hADX, (int)InpADXLinha, 0, n, gADX) < n) return false;

   ArrayResize(gUpper, n);
   ArrayResize(gLower, n);
   ArrayResize(gTrend, n);
   ArrayResize(gST, n);
   ArraySetAsSeries(gUpper, true);
   ArraySetAsSeries(gLower, true);
   ArraySetAsSeries(gTrend, true);
   ArraySetAsSeries(gST, true);

   for(int i = n - 1; i >= 0; i--)
     {
      double hl2        = (gRates[i].high + gRates[i].low) * 0.5;
      double upperBasic = hl2 + pMult * gATR[i];
      double lowerBasic = hl2 - pMult * gATR[i];

      if(i == n - 1)
        {
         gUpper[i] = upperBasic;
         gLower[i] = lowerBasic;
         gTrend[i] = 1;
         gST[i]    = lowerBasic;
         continue;
        }

      if(upperBasic < gUpper[i + 1] || gRates[i + 1].close > gUpper[i + 1])
         gUpper[i] = upperBasic;
      else
         gUpper[i] = gUpper[i + 1];

      if(lowerBasic > gLower[i + 1] || gRates[i + 1].close < gLower[i + 1])
         gLower[i] = lowerBasic;
      else
         gLower[i] = gLower[i + 1];

      double trend = gTrend[i + 1];
      if(trend > 0)
         trend = (gRates[i].close < gLower[i] ? -1 : 1);
      else
         trend = (gRates[i].close > gUpper[i] ? 1 : -1);
      gTrend[i] = trend;
      gST[i]    = (trend > 0 ? gLower[i] : gUpper[i]);
     }

   gN = n;
   return true;
  }

//+------------------------------------------------------------------+
//| Padroes do indicador original                                    |
//+------------------------------------------------------------------+
bool IsBullishEngulfing(int i)
  {
   if(i + 1 >= gN) return false;
   double o = gRates[i].open, c = gRates[i].close;
   double po = gRates[i + 1].open, pc = gRates[i + 1].close;
   bool prevBearish = pc < po;
   bool currBullish = c > o;
   bool engulfs     = (o <= pc) && (c >= po);
   bool significant = MathAbs(c - o) > MathAbs(pc - po);
   return (prevBearish && currBullish && engulfs && significant);
  }

bool IsBearishEngulfing(int i)
  {
   if(i + 1 >= gN) return false;
   double o = gRates[i].open, c = gRates[i].close;
   double po = gRates[i + 1].open, pc = gRates[i + 1].close;
   bool prevBullish = pc > po;
   bool currBearish = c < o;
   bool engulfs     = (o >= pc) && (c <= po);
   bool significant = MathAbs(c - o) > MathAbs(pc - po);
   return (prevBullish && currBearish && engulfs && significant);
  }

bool ADXRising(int i, int risingBars)
  {
   if(risingBars <= 0) return true;
   for(int k = 0; k < risingBars; k++)
     {
      if(i + k + 1 >= gN) return false;
      if(!(gADX[i + k] > gADX[i + k + 1])) return false;
     }
   return true;
  }

// 0 = sem seta, 1 = compra dourada, -1 = venda dourada, 2 = compra engolfo, -2 = venda engolfo
int SinalIndicador(int i)
  {
   if(i + 1 >= gN) return 0;
   bool adxIn   = (gADX[i] >= pADXMin && gADX[i] <= pADXMax);
   bool adxRise = ADXRising(i, InpADX_RisingBars);

   bool longBasic  = (gTrend[i] > 0 && gRates[i].close > gEMA[i] && adxIn && adxRise);
   bool shortBasic = (gTrend[i] < 0 && gRates[i].close < gEMA[i] && adxIn && adxRise);

   if(InpOnlyOneSignalPerFlip)
     {
      if(longBasic  && !(gTrend[i + 1] < 0)) longBasic  = false;
      if(shortBasic && !(gTrend[i + 1] > 0)) shortBasic = false;
     }

   if(InpShowEngolfo)
     {
      if(longBasic  && IsBullishEngulfing(i)) return 2;
      if(shortBasic && IsBearishEngulfing(i)) return -2;
     }
   if(longBasic)  return 1;
   if(shortBasic) return -1;
   return 0;
  }

//+------------------------------------------------------------------+
//| Desenho do indicador no grafico                                  |
//+------------------------------------------------------------------+
void Segmento(string nome, datetime t1, double v1, datetime t2, double v2, color c, int largura)
  {
   if(ObjectFind(0, nome) < 0)
     {
      ObjectCreate(0, nome, OBJ_TREND, 0, t1, v1, t2, v2);
      ObjectSetInteger(0, nome, OBJPROP_RAY_RIGHT, false);
      ObjectSetInteger(0, nome, OBJPROP_RAY_LEFT, false);
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, nome, OBJPROP_BACK, false);
     }
   else
     {
      ObjectMove(0, nome, 0, t1, v1);
      ObjectMove(0, nome, 1, t2, v2);
     }
   ObjectSetInteger(0, nome, OBJPROP_COLOR, c);
   ObjectSetInteger(0, nome, OBJPROP_WIDTH, largura);
  }

void Seta(string nome, datetime t, double preco, int codigo, color c, int largura, bool paraCima)
  {
   if(ObjectFind(0, nome) < 0)
     {
      ObjectCreate(0, nome, OBJ_ARROW, 0, t, preco);
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
     }
   else
      ObjectMove(0, nome, 0, t, preco);
   ObjectSetInteger(0, nome, OBJPROP_ARROWCODE, codigo);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, c);
   ObjectSetInteger(0, nome, OBJPROP_WIDTH, largura);
   ObjectSetInteger(0, nome, OBJPROP_ANCHOR, paraCima ? ANCHOR_TOP : ANCHOR_BOTTOM);
  }

void Apagar(string nome)
  {
   if(ObjectFind(0, nome) >= 0)
      ObjectDelete(0, nome);
  }

void DesenharBarra(int i)
  {
   if(i + 1 >= gN) return;
   string id = IntegerToString((long)gRates[i].time);

   // SuperTrend: segmento entre i+1 e i quando a cor e a mesma (como DRAW_LINE)
   string nST = PFX + "ST_" + id;
   if(InpShowSupertrend && gTrend[i] == gTrend[i + 1])
      Segmento(nST, gRates[i + 1].time, gST[i + 1], gRates[i].time, gST[i],
               gTrend[i] > 0 ? InpCorAlta : InpCorBaixa, 2);
   else
      Apagar(nST);

   // EMA
   string nEMA = PFX + "EMA_" + id;
   if(InpShowEMA)
      Segmento(nEMA, gRates[i + 1].time, gEMA[i + 1], gRates[i].time, gEMA[i], InpCorEMA, 1);
   else
      Apagar(nEMA);

   // Setas do indicador (so em velas fechadas)
   string nSig = PFX + "SIG_" + id;
   int s = (i >= 1 && InpShowSignals) ? SinalIndicador(i) : 0;
   if(s == 2)
      Seta(nSig, gRates[i].time, gRates[i].low - gATR[i] * 0.3, 233, clrDodgerBlue, 3, true);
   else if(s == -2)
      Seta(nSig, gRates[i].time, gRates[i].high + gATR[i] * 0.3, 234, clrRed, 3, false);
   else if(s == 1)
      Seta(nSig, gRates[i].time, gRates[i].low - gATR[i] * 0.25, 233, clrGold, 2, true);
   else if(s == -1)
      Seta(nSig, gRates[i].time, gRates[i].high + gATR[i] * 0.25, 234, clrGold, 2, false);
   else
      Apagar(nSig);
  }

void DesenharTudo()
  {
   int lim = MathMin(InpBarsDraw, gN - 2);
   for(int i = 0; i <= lim; i++)
      DesenharBarra(i);
   // remove o que saiu da janela de desenho
   for(int i = lim + 1; i <= lim + 5 && i < gN; i++)
     {
      string id = IntegerToString((long)gRates[i].time);
      Apagar(PFX + "ST_" + id);
      Apagar(PFX + "EMA_" + id);
      Apagar(PFX + "SIG_" + id);
     }
   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| Filtros de entrada                                               |
//+------------------------------------------------------------------+
bool VelaForca(int i, int dir)
  {
   if(!InpUsarVelaForca) return true;
   double o = gRates[i].open, c = gRates[i].close;
   double range = gRates[i].high - gRates[i].low;
   if(range <= 0) return false;
   if(dir > 0 && c <= o) return false;
   if(dir < 0 && c >= o) return false;
   if(MathAbs(c - o) / range * 100.0 < InpCorpoMinPct) return false;
   if(InpForcaATRMult > 0 && range < gATR[i] * InpForcaATRMult) return false;
   return true;
  }

double VolumeBarra(int i)
  {
   if(InpVolumeReal && gRates[i].real_volume > 0)
      return (double)gRates[i].real_volume;
   return (double)gRates[i].tick_volume;
  }

bool VolumeForte(int i)
  {
   if(!InpUsarVolume) return true;
   int p = MathMax(1, InpVolumePeriodo);
   if(i + p >= gN) return false;
   double soma = 0;
   for(int k = i + 1; k <= i + p; k++)
      soma += VolumeBarra(k);
   double media = soma / p;
   return (VolumeBarra(i) >= media * InpVolumeMult);
  }

bool FiltrosExtras(int i, int dir)
  {
   if(InpFiltroEMA)
     {
      if(dir > 0 && gRates[i].close <= gEMA[i]) return false;
      if(dir < 0 && gRates[i].close >= gEMA[i]) return false;
     }
   if(InpFiltroADX)
     {
      if(gADX[i] < pADXMin || gADX[i] > pADXMax) return false;
     }
   return true;
  }

//+------------------------------------------------------------------+
//| Stop no ultimo fundo / topo                                      |
//+------------------------------------------------------------------+
double UltimoFundo(double abaixoDe)
  {
   int k = MathMax(1, InpFundoPivo);
   int lim = MathMin(InpFundoLookback, gN - k - 1);
   for(int i = k + 1; i <= lim; i++)
     {
      double v = gRates[i].low;
      if(v >= abaixoDe) continue;
      bool piv = true;
      for(int j = 1; j <= k; j++)
        {
         if(v > gRates[i - j].low || v >= gRates[i + j].low) { piv = false; break; }
        }
      if(piv) return v;
     }
   // sem pivo confirmado: menor minima das ultimas velas
   double mn = DBL_MAX;
   for(int i = 1; i <= lim; i++)
      mn = MathMin(mn, gRates[i].low);
   return (mn < abaixoDe ? mn : 0.0);
  }

double UltimoTopo(double acimaDe)
  {
   int k = MathMax(1, InpFundoPivo);
   int lim = MathMin(InpFundoLookback, gN - k - 1);
   for(int i = k + 1; i <= lim; i++)
     {
      double v = gRates[i].high;
      if(v <= acimaDe) continue;
      bool piv = true;
      for(int j = 1; j <= k; j++)
        {
         if(v < gRates[i - j].high || v <= gRates[i + j].high) { piv = false; break; }
        }
      if(piv) return v;
     }
   double mx = 0.0;
   for(int i = 1; i <= lim; i++)
      mx = MathMax(mx, gRates[i].high);
   return (mx > acimaDe ? mx : 0.0);
  }

//+------------------------------------------------------------------+
//| Lote                                                             |
//+------------------------------------------------------------------+
double NormalizarLote(double lote)
  {
   double mn   = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double mx   = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   if(step <= 0) step = mn;
   lote = MathFloor(lote / step) * step;
   lote = MathMax(mn, MathMin(mx, lote));
   return NormalizeDouble(lote, 8);
  }

double CalcularLote(double distStop)
  {
   if(InpLoteModo == LOTE_FIXO || distStop <= 0)
      return NormalizarLote(InpLoteFixo);

   double tickVal  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE_LOSS);
   if(tickVal <= 0) tickVal = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   if(tickVal <= 0 || tickSize <= 0)
      return NormalizarLote(InpLoteFixo);

   double risco      = AccountInfoDouble(ACCOUNT_BALANCE) * InpRiscoPct / 100.0;
   double perdaPorLote = distStop / tickSize * tickVal;
   if(perdaPorLote <= 0)
      return NormalizarLote(InpLoteFixo);
   return NormalizarLote(risco / perdaPorLote);
  }

//+------------------------------------------------------------------+
//| Posicoes e historico                                             |
//+------------------------------------------------------------------+
bool MinhaPosicao(int idx, ulong &ticket)
  {
   ticket = PositionGetTicket(idx);
   if(ticket == 0) return false;
   if(PositionGetString(POSITION_SYMBOL) != _Symbol) return false;
   if((ulong)PositionGetInteger(POSITION_MAGIC) != InpMagic) return false;
   return true;
  }

int ContarPosicoes(int &dir, double &lotes, double &flutuante)
  {
   int n = 0;
   dir = 0; lotes = 0; flutuante = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong t;
      if(!MinhaPosicao(i, t)) continue;
      n++;
      dir = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY ? 1 : -1);
      lotes += PositionGetDouble(POSITION_VOLUME);
      flutuante += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
     }
   return n;
  }

void FecharTudo(string motivo)
  {
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong t;
      if(!MinhaPosicao(i, t)) continue;
      if(!trade.PositionClose(t))
         PrintFormat("Falha ao fechar #%I64u (%s): %d", t, motivo, trade.ResultRetcode());
      else
         PrintFormat("Posicao #%I64u fechada: %s", t, motivo);
     }
  }

// resultado fechado e numero de entradas desde 'desde' (hora do servidor)
void Historico(datetime desde, double &resultado, int &entradas)
  {
   resultado = 0; entradas = 0;
   if(!HistorySelect(desde, TimeTradeServer() + 86400))
      return;
   int total = HistoryDealsTotal();
   for(int i = 0; i < total; i++)
     {
      ulong d = HistoryDealGetTicket(i);
      if(d == 0) continue;
      if(HistoryDealGetString(d, DEAL_SYMBOL) != _Symbol) continue;
      if((ulong)HistoryDealGetInteger(d, DEAL_MAGIC) != InpMagic) continue;
      if((datetime)HistoryDealGetInteger(d, DEAL_TIME) < desde) continue;
      long entry = HistoryDealGetInteger(d, DEAL_ENTRY);
      if(entry == DEAL_ENTRY_IN)
         entradas++;
      resultado += HistoryDealGetDouble(d, DEAL_PROFIT)
                 + HistoryDealGetDouble(d, DEAL_SWAP)
                 + HistoryDealGetDouble(d, DEAL_COMMISSION);
     }
  }

// resultado do ciclo: so posicoes ABERTAS dentro do ciclo (fechado + flutuante)
void HistoricoCiclo(datetime desde, double &resultado, int &entradas)
  {
   resultado = 0; entradas = 0;
   ulong ids[];
   int nIds = 0;
   if(HistorySelect(desde, TimeTradeServer() + 86400))
     {
      int total = HistoryDealsTotal();
      for(int i = 0; i < total; i++)
        {
         ulong d = HistoryDealGetTicket(i);
         if(d == 0) continue;
         if(HistoryDealGetString(d, DEAL_SYMBOL) != _Symbol) continue;
         if((ulong)HistoryDealGetInteger(d, DEAL_MAGIC) != InpMagic) continue;
         if(HistoryDealGetInteger(d, DEAL_ENTRY) != DEAL_ENTRY_IN) continue;
         if((datetime)HistoryDealGetInteger(d, DEAL_TIME) < desde) continue;
         ArrayResize(ids, nIds + 1);
         ids[nIds++] = (ulong)HistoryDealGetInteger(d, DEAL_POSITION_ID);
        }
      entradas = nIds;
      for(int i = 0; i < total; i++)
        {
         ulong d = HistoryDealGetTicket(i);
         if(d == 0) continue;
         ulong pid = (ulong)HistoryDealGetInteger(d, DEAL_POSITION_ID);
         bool doCiclo = false;
         for(int k = 0; k < nIds; k++)
            if(ids[k] == pid) { doCiclo = true; break; }
         if(!doCiclo) continue;
         resultado += HistoryDealGetDouble(d, DEAL_PROFIT)
                    + HistoryDealGetDouble(d, DEAL_SWAP)
                    + HistoryDealGetDouble(d, DEAL_COMMISSION);
        }
     }
   // flutuante das posicoes abertas no ciclo
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong t;
      if(!MinhaPosicao(i, t)) continue;
      if((datetime)PositionGetInteger(POSITION_TIME) < desde) continue;
      resultado += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
     }
  }

//+------------------------------------------------------------------+
//| Ciclo atual da SuperTrend (a partir das velas fechadas)          |
//+------------------------------------------------------------------+
void AtualizarCiclo()
  {
   if(gN < 3) return;
   int k = 1;
   while(k + 1 < gN && gTrend[k] == gTrend[k + 1])
      k++;
   gCicloInicio = gRates[k].time + PeriodSeconds(_Period);
   gCicloBarras = k - 1;
  }

void AtualizarEstado()
  {
   int dir; double lotes, flut;
   ContarPosicoes(dir, lotes, flut);

   double r; int e;
   Historico(InicioDiaServidor(), r, e);
   gDiaResultado = r + flut;
   gDiaEntradas  = e;

   if(gCicloInicio > 0)
      HistoricoCiclo(gCicloInicio, gCicloResultado, gCicloEntradas);
  }

bool DiaBloqueado(string &motivo)
  {
   if(InpUsarMetaDia && gDiaResultado >= InpMetaDia) { motivo = "META DIARIA ATINGIDA"; return true; }
   if(InpUsarStopDia && gDiaResultado <= -InpStopDia) { motivo = "STOP DIARIO ATINGIDO"; return true; }
   return false;
  }

bool CicloBloqueado()
  {
   return (InpUsarMetaCiclo && gCicloResultado >= InpMetaCiclo);
  }

//+------------------------------------------------------------------+
//| Gestao: BE e trailing                                            |
//+------------------------------------------------------------------+
void Gerenciar()
  {
   if(!InpUsarBE && !InpUsarTrailing) return;
   double pt    = _Point;
   int    dig   = _Digits;
   double nivel = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * pt;
   double bid   = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask   = SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong t;
      if(!MinhaPosicao(i, t)) continue;
      bool   compra = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
      double abre   = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl     = PositionGetDouble(POSITION_SL);
      double tp     = PositionGetDouble(POSITION_TP);
      double lucroPts = (compra ? bid - abre : abre - ask) / pt;
      double novo   = sl;

      if(InpUsarBE && lucroPts >= InpBEGatilhoPts)
        {
         double be = compra ? abre + InpBEOffsetPts * pt : abre - InpBEOffsetPts * pt;
         if(compra && (sl == 0 || be > novo)) novo = be;
         if(!compra && (sl == 0 || be < novo)) novo = be;
        }

      if(InpUsarTrailing && lucroPts > 0 && lucroPts >= InpTrailInicioPts)
        {
         double tr = compra ? bid - InpTrailDistPts * pt : ask + InpTrailDistPts * pt;
         if(compra && (novo == 0 || tr >= novo + InpTrailPassoPts * pt)) novo = tr;
         if(!compra && (novo == 0 || tr <= novo - InpTrailPassoPts * pt)) novo = tr;
        }

      novo = NormalizeDouble(novo, dig);
      if(novo == sl || novo == 0) continue;
      if(compra && novo > bid - nivel) continue;
      if(!compra && novo < ask + nivel) continue;
      if(!trade.PositionModify(t, novo, tp))
         PrintFormat("Falha ao mover stop #%I64u: %d", t, trade.ResultRetcode());
     }
  }

//+------------------------------------------------------------------+
//| Entrada                                                          |
//+------------------------------------------------------------------+
void MarcarEntrada(int dir, double preco)
  {
   if(!InpShowEntradas) return;
   string nome = PFX + "ENT_" + IntegerToString((long)TimeCurrent());
   ObjectCreate(0, nome, OBJ_ARROW, 0, TimeCurrent(), preco);
   ObjectSetInteger(0, nome, OBJPROP_ARROWCODE, dir > 0 ? 241 : 242);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, dir > 0 ? clrAqua : clrMagenta);
   ObjectSetInteger(0, nome, OBJPROP_WIDTH, 3);
   ObjectSetInteger(0, nome, OBJPROP_ANCHOR, dir > 0 ? ANCHOR_TOP : ANCHOR_BOTTOM);
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
  }

void TentarEntrada()
  {
   if(gN < 3) return;
   int dir = (gTrend[1] > 0 ? 1 : -1);

   if(dir > 0 && InpDirecao == DIR_SO_VENDA)  return;
   if(dir < 0 && InpDirecao == DIR_SO_COMPRA) return;
   if(!DentroHorario()) return;

   string m;
   if(DiaBloqueado(m)) return;
   if(CicloBloqueado()) return;

   int pd; double pl, pf;
   if(ContarPosicoes(pd, pl, pf) > 0) return;

   if(InpUmaEntradaCiclo && gCicloEntradas > 0) return;
   // primeira entrada do ciclo: so perto da virada; reentradas (se permitidas) em qualquer vela de forca
   if(gCicloEntradas == 0 && gCicloBarras > InpJanelaVirada) return;

   if(!VelaForca(1, dir))       return;
   if(!VolumeForte(1))          return;
   if(!FiltrosExtras(1, dir))   return;

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double pt  = _Point;
   int    dig = _Digits;
   double preco = (dir > 0 ? ask : bid);
   double nivel = (double)MathMax(SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL),
                                  SymbolInfoInteger(_Symbol, SYMBOL_TRADE_FREEZE_LEVEL)) * pt;

   // ---- stop
   double sl = 0;
   if(InpStopModo == STOP_ULTIMO_FUNDO)
     {
      if(dir > 0)
        {
         double f = UltimoFundo(bid);
         if(f > 0) sl = f - InpStopFolgaPts * pt;
        }
      else
        {
         double tp0 = UltimoTopo(ask);
         if(tp0 > 0) sl = tp0 + InpStopFolgaPts * pt;
        }
      if(sl == 0)
        {
         Print("Sem fundo/topo valido para o stop - entrada ignorada");
         return;
        }
     }
   else if(InpStopModo == STOP_PONTOS)
      sl = (dir > 0 ? preco - InpStopPontos * pt : preco + InpStopPontos * pt);

   if(sl != 0)
     {
      // respeita o stop level da corretora
      if(dir > 0 && sl > bid - nivel) sl = bid - nivel - pt;
      if(dir < 0 && sl < ask + nivel) sl = ask + nivel + pt;
      sl = NormalizeDouble(sl, dig);
     }

   double dist = (sl != 0 ? MathAbs(preco - sl) : 0);
   if(InpStopMaxPts > 0 && dist > InpStopMaxPts * pt)
     {
      PrintFormat("Stop de %.0f pts maior que o maximo (%d) - entrada ignorada", dist / pt, InpStopMaxPts);
      return;
     }

   // ---- take
   double tp = 0;
   double rr = 0;
   if(InpTakeModo == TAKE_RR_1_1) rr = 1.0;
   if(InpTakeModo == TAKE_RR_1_2) rr = 2.0;
   if(InpTakeModo == TAKE_RR_1_3) rr = 3.0;
   if(rr > 0 && dist > 0)
      tp = (dir > 0 ? preco + dist * rr : preco - dist * rr);
   else if(InpTakeModo == TAKE_PONTOS)
      tp = (dir > 0 ? preco + InpTakePontos * pt : preco - InpTakePontos * pt);
   if(tp != 0)
     {
      if(dir > 0 && tp < ask + nivel) tp = ask + nivel + pt;
      if(dir < 0 && tp > bid - nivel) tp = bid - nivel - pt;
      tp = NormalizeDouble(tp, dig);
     }

   double lote = CalcularLote(dist);
   bool ok = (dir > 0) ? trade.Buy(lote, _Symbol, ask, sl, tp, InpComentario)
                       : trade.Sell(lote, _Symbol, bid, sl, tp, InpComentario);
   if(ok && (trade.ResultRetcode() == TRADE_RETCODE_DONE || trade.ResultRetcode() == TRADE_RETCODE_PLACED))
     {
      PrintFormat("%s %.2f lotes @ %s | SL %s | TP %s", dir > 0 ? "COMPRA" : "VENDA", lote,
                  DoubleToString(preco, dig), DoubleToString(sl, dig), DoubleToString(tp, dig));
      MarcarEntrada(dir, dir > 0 ? gRates[1].low : gRates[1].high);
      AtualizarEstado();
     }
   else
      PrintFormat("Falha na entrada: %d %s", trade.ResultRetcode(), trade.ResultRetcodeDescription());
  }

//+------------------------------------------------------------------+
//| Preco grande (canto superior direito)                            |
//+------------------------------------------------------------------+
void Label(string nome, int corner, int anchor, int x, int y, string txt, color c, int tam, string fonte)
  {
   if(ObjectFind(0, nome) < 0)
     {
      ObjectCreate(0, nome, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, nome, OBJPROP_BACK, false);
     }
   ObjectSetInteger(0, nome, OBJPROP_CORNER, corner);
   ObjectSetInteger(0, nome, OBJPROP_ANCHOR, anchor);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetString(0, nome, OBJPROP_TEXT, txt);
   ObjectSetString(0, nome, OBJPROP_FONT, fonte);
   ObjectSetInteger(0, nome, OBJPROP_FONTSIZE, tam);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, c);
  }

void Retangulo(string nome, int x, int y, int w, int h, color fundo, color borda)
  {
   if(ObjectFind(0, nome) < 0)
     {
      ObjectCreate(0, nome, OBJ_RECTANGLE_LABEL, 0, 0, 0);
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, nome, OBJPROP_BACK, false);
      ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, nome, OBJPROP_BORDER_TYPE, BORDER_FLAT);
     }
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_XSIZE, w);
   ObjectSetInteger(0, nome, OBJPROP_YSIZE, h);
   ObjectSetInteger(0, nome, OBJPROP_BGCOLOR, fundo);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, borda);
  }

void AtualizarPreco()
  {
   if(!InpShowPreco) return;
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   if(gLastBid > 0)
     {
      if(bid > gLastBid) gCorPreco = clrLime;
      else if(bid < gLastBid) gCorPreco = clrTomato;
     }
   gLastBid = bid;
   Label(PFX + "PRECO", CORNER_RIGHT_UPPER, ANCHOR_RIGHT_UPPER, 20, 18,
         DoubleToString(bid, _Digits), gCorPreco, InpPrecoFonte, "Arial Black");
   Label(PFX + "PRECO_SYM", CORNER_RIGHT_UPPER, ANCHOR_RIGHT_UPPER, 22, 22 + InpPrecoFonte * 2,
         _Symbol + "  " + StringSubstr(EnumToString(_Period), 7), clrSilver, 10, "Arial");
  }

//+------------------------------------------------------------------+
//| Painel (lado esquerdo)                                           |
//+------------------------------------------------------------------+
void AtualizarPainel()
  {
   if(!InpShowPainel) return;
   int x = 10, y = 30, w = 270, lh = 20;
   color fundo = C'16,20,32', borda = C'60,70,95', txt = clrWhite;

   Retangulo(PFX + "P_BG", x, y, w, 12 + lh * 9, fundo, borda);
   Label(PFX + "P_T", CORNER_LEFT_UPPER, ANCHOR_LEFT_UPPER, x + 10, y + 6,
         "RickEA SuperTrend Bot", clrGold, 11, "Arial Black");

   // tendencia com a cor da SuperTrend
   bool alta = (gN > 1 && gTrend[1] > 0);
   color ct  = alta ? InpCorAlta : InpCorBaixa;
   Retangulo(PFX + "P_TR", x + 10, y + 8 + lh * 1, 14, 14, ct, ct);
   Label(PFX + "P_L1", CORNER_LEFT_UPPER, ANCHOR_LEFT_UPPER, x + 30, y + 6 + lh * 1,
         "Tendencia: " + (alta ? "ALTA (compra)" : "BAIXA (venda)"), ct, 10, "Arial Bold");

   color cr = (gDiaResultado > 0 ? clrLime : (gDiaResultado < 0 ? clrTomato : txt));
   Label(PFX + "P_L2", CORNER_LEFT_UPPER, ANCHOR_LEFT_UPPER, x + 10, y + 6 + lh * 2,
         "Resultado hoje: " + Sinal(gDiaResultado) + " " + Moeda(), cr, 10, "Arial Bold");
   Label(PFX + "P_L3", CORNER_LEFT_UPPER, ANCHOR_LEFT_UPPER, x + 10, y + 6 + lh * 3,
         "Entradas hoje: " + IntegerToString(gDiaEntradas), txt, 10, "Arial");

   int pd; double pl, pf;
   string pos = "Posicao: ZERADO";
   color  cp  = clrSilver;
   if(ContarPosicoes(pd, pl, pf) > 0)
     {
      pos = StringFormat("Posicao: %s %.2f | %s", pd > 0 ? "COMPRADO" : "VENDIDO", pl, Sinal(pf));
      cp  = (pd > 0 ? InpCorAlta : InpCorBaixa);
     }
   Label(PFX + "P_L4", CORNER_LEFT_UPPER, ANCHOR_LEFT_UPPER, x + 10, y + 6 + lh * 4, pos, cp, 10, "Arial Bold");

   Label(PFX + "P_L5", CORNER_LEFT_UPPER, ANCHOR_LEFT_UPPER, x + 10, y + 6 + lh * 5,
         StringFormat("Ciclo: %d entrada(s) | %s", gCicloEntradas, Sinal(gCicloResultado)), txt, 10, "Arial");

   string d = (InpDirecao == DIR_AMBOS ? "Compra+Venda" : (InpDirecao == DIR_SO_COMPRA ? "So compras" : "So vendas"));
   Label(PFX + "P_L6", CORNER_LEFT_UPPER, ANCHOR_LEFT_UPPER, x + 10, y + 6 + lh * 6,
         "Modo: " + d + (InpUmaEntradaCiclo ? " | 1 por ciclo" : ""), clrSilver, 9, "Arial");

   Label(PFX + "P_L7", CORNER_LEFT_UPPER, ANCHOR_LEFT_UPPER, x + 10, y + 6 + lh * 7,
         "Hora PC: " + TimeToString(TimeLocal(), TIME_MINUTES) +
         (InpUsarHorario ? " | " + InpHoraInicio + "-" + InpHoraFim : ""), clrSilver, 9, "Arial");

   color cs = (gStatus == "OPERANDO" ? clrLime : clrOrange);
   Label(PFX + "P_L8", CORNER_LEFT_UPPER, ANCHOR_LEFT_UPPER, x + 10, y + 6 + lh * 8,
         "Status: " + gStatus, cs, 10, "Arial Bold");
  }

//+------------------------------------------------------------------+
//| Rotina principal (tick / timer)                                  |
//+------------------------------------------------------------------+
bool gDesenhoOk = false;

bool Processar(bool novaBarra, bool permitirEntrada)
  {
   if(!Calcular())
      return false;

   AtualizarCiclo();
   AtualizarEstado();

   if(novaBarra || !gDesenhoOk)
     {
      DesenharTudo();
      gDesenhoOk = true;
     }
   else
     {
      DesenharBarra(0);
      DesenharBarra(1);
     }

   // status e protecoes
   string motivo;
   bool horario = DentroHorario();
   if(DiaBloqueado(motivo))
     {
      FecharTudo(motivo);
      gStatus = motivo;
     }
   else if(CicloBloqueado())
     {
      FecharTudo("meta do ciclo");
      gStatus = "META DO CICLO - aguardando virada";
     }
   else if(!horario)
     {
      if(InpFecharFimHorario) FecharTudo("fora do horario");
      gStatus = "FORA DO HORARIO";
     }
   else
      gStatus = "OPERANDO";

   // fecha contra a virada
   if(novaBarra && InpFecharNaVirada && gN > 2)
     {
      int pd; double pl, pf;
      int dirTrend = (gTrend[1] > 0 ? 1 : -1);
      if(ContarPosicoes(pd, pl, pf) > 0 && pd != dirTrend)
        {
         FecharTudo("SuperTrend virou contra");
         AtualizarEstado();
        }
     }

   Gerenciar();

   if(novaBarra && permitirEntrada)
      TentarEntrada();

   AtualizarPainel();
   AtualizarPreco();
   ChartRedraw();
   return true;
  }

//+------------------------------------------------------------------+
//| Eventos                                                          |
//+------------------------------------------------------------------+
int OnInit()
  {
   trade.SetExpertMagicNumber(InpMagic);
   trade.SetDeviationInPoints(InpSlippage);
   trade.SetTypeFillingBySymbol(_Symbol);

   gIniMin = ParseHHMM(InpHoraInicio);
   gFimMin = ParseHHMM(InpHoraFim);

   ObjectsDeleteAll(0, PFX);
   if(InpShowLogo)
      LogoCriar();

   // nao entra no sinal de uma vela que ja fechou antes do robo ser ligado
   gLastBarTime = iTime(_Symbol, _Period, 0);
   gDesenhoOk = false;
   EventSetTimer(1);
   Processar(true, false);
   return(INIT_SUCCEEDED);
  }

void OnDeinit(const int reason)
  {
   EventKillTimer();
   ObjectsDeleteAll(0, PFX);
   ResourceFree(LOGO_RES);
   if(hEMA != INVALID_HANDLE) IndicatorRelease(hEMA);
   if(hADX != INVALID_HANDLE) IndicatorRelease(hADX);
   if(hATR != INVALID_HANDLE) IndicatorRelease(hATR);
   ChartRedraw();
  }

void OnTick()
  {
   datetime t = iTime(_Symbol, _Period, 0);
   bool nova = (t != gLastBarTime);
   if(nova)
     {
      if(Processar(true, true))   // so marca a vela como processada se os dados vieram
         gLastBarTime = t;
      return;
     }
   Gerenciar();
   AtualizarPreco();
  }

void OnTimer()
  {
   Processar(false, false);
  }

void OnChartEvent(const int id, const long &lparam, const double &dparam, const string &sparam)
  {
   if(id == CHARTEVENT_CHART_CHANGE && InpShowLogo)
      LogoPosicionar();
  }

