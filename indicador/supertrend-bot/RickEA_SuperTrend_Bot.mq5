// === LOGO DATA END ===

//+------------------------------------------------------------------+
//| Logo RickEA embutido (sem arquivo externo)                       |
//+------------------------------------------------------------------+
void LogoCriar()
  {
   int s = MathMax(40, InpLogoTamanho);
   int op = MathMax(0, MathMin(255, InpLogoOpacidade));
   uint px[];
   ArrayResize(px, s * s);
   for(int y = 0; y < s; y++)
     {
      int sy = y * LOGO_H / s;
      for(int x = 0; x < s; x++)
        {
         int  sx = x * LOGO_W / s;
         uint c  = LOGO_DATA[sy * LOGO_W + sx];
         uint a  = ((c >> 24) & 0xFF) * (uint)op / 255;
         px[y * s + x] = (a << 24) | (c & 0x00FFFFFF);
        }
     }
   if(!ResourceCreate(LOGO_RES, px, s, s, 0, 0, s, COLOR_FORMAT_ARGB_NORMALIZE))
     {
      Print("Falha ao criar o logo: ", GetLastError());
      return;
     }
   string nome = PFX + "LOGO";
   if(ObjectFind(0, nome) < 0)
      ObjectCreate(0, nome, OBJ_BITMAP_LABEL, 0, 0, 0);
   ObjectSetString(0, nome, OBJPROP_BMPFILE, 0, LOGO_RES);
   ObjectSetString(0, nome, OBJPROP_BMPFILE, 1, LOGO_RES);
   ObjectSetInteger(0, nome, OBJPROP_BACK, true);          // atras dos candles
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, nome, OBJPROP_ANCHOR, ANCHOR_LEFT_UPPER);
   LogoPosicionar();
  }

void LogoPosicionar()
  {
   string nome = PFX + "LOGO";
   if(ObjectFind(0, nome) < 0) return;
   int s  = MathMax(40, InpLogoTamanho);
   int cw = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   int ch = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);
   int x = (cw - s) / 2, y = (ch - s) / 2;
   if(InpLogoPos == LOGO_INF_DIR) { x = cw - s - 70; y = ch - s - 30; }
   if(InpLogoPos == LOGO_INF_ESQ) { x = 20;          y = ch - s - 30; }
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, MathMax(0, x));
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, MathMax(0, y));
   ChartRedraw();
  }

